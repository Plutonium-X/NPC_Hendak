// CUTSCENE BRYNNLAW


IF
  True()
THEN
  RESPONSE #100
    CutSceneId("HB#LeSer")
    ClearAllActions()
    Wait(1)
    DisplayStringWait(Myself,@11)
    DisplayStringWait("HB#Smee",@12)
    DisplayStringWait(Myself,@13)
    DisplayStringWait("HB#Smee",@14)
    PlaySong(0)
    PlaySound("HB#MusiE")
    DisplayStringWait(Myself,@15)
    DisplayStringWait("HB#Smee",@16)
    DisplayStringWait(Myself,@17)
    ActionOverride("HB#Serpe",MoveToObject("HB#Smee"))
    DisplayStringWait("HB#Smee",@18)
    Wait(2)
    ActionOverride(Player1,MoveToPoint([1727.1976]))
    ActionOverride(Player2,MoveToPoint([1692.1966]))
    ActionOverride(Player3,MoveToPoint([1686.2022]))
    ActionOverride(Player4,MoveToPoint([1608.1960]))
    ActionOverride(Player5,MoveToPoint([1588.2013]))
    ActionOverride(Player6,MoveToPoint([1587.2081]))
    ActionOverride(Player1,Face(10))
    ActionOverride(Player2,Face(10))
    ActionOverride(Player3,Face(10))
    ActionOverride(Player4,Face(10))
    ActionOverride(Player5,Face(10))
    ActionOverride(Player6,Face(10))
    DisplayStringHead(Myself,@19)
    Wait(8)
    DisplayStringHead(Player1,@30)
    Wait(8)
    CreateCreature("HB#Pir01",[1549.2215],8)
    DisplayStringHead("HB#Pir01",@31)
    Wait(8)
    CreateCreature("HB#Pir02",[1782.2143],6)
    DisplayStringHead("HB#Pir02",@32)
    Wait(8)
    CreateCreature("HB#Pir03",[1509.1971],10)
    DisplayStringHead("HB#Pir03",@33)
    Wait(8)
    CreateCreature("HB#Pir04",[1600.1810],14)
    DisplayStringHead("HB#Pir04",@34)
    Wait(8)
    CreateCreatureDoor("HB#PIR05",[1588.1760],14)
    DisplayStringHead("HB#PIR05",@37)
    Wait(8)
    DisplayStringHead("HB#Smee",@36)
    ActionOverride("HB#Smee",EscapeArea())
    Wait(8)
    ActionOverride("HB#Pir01",Enemy())
    ActionOverride("HB#Pir02",Enemy())
    ActionOverride("HB#Pir03",Enemy())
    ActionOverride("HB#Pir04",Enemy())
    ActionOverride("HB#PIR05",Enemy())
    ActionOverride("HB#Serpe",Enemy())
    SetGlobal("HB#Poursuite","GLOBAL",10)
    StartDialogueNoSet(Player1)
    EndCutSceneMode()
END



