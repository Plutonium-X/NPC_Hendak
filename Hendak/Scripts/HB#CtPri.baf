//CUTSCENE PRISON

IF
	True()
THEN
	RESPONSE #100
		CutSceneId(Player1)
		CreateVisualEffectObject("SPFLSRIN",Player1)
		Wait(1)
		CreateVisualEffectObject("SPFIREPI",Player1)
		ReallyForceSpell(Myself,WIZARD_SPELL_TRAP)
		CreateVisualEffectObject("SPFLSRIN",Player2)
		Wait(1)
		CreateVisualEffectObject("SPFIREPI",Player2)
		ActionOverride(Player2,ReallyForceSpell(Player2,WIZARD_SPELL_TRAP))
		CreateVisualEffectObject("SPFLSRIN",Player3)
		Wait(1)
		CreateVisualEffectObject("SPFIREPI",Player3)
		ActionOverride(Player3,ReallyForceSpell(Player3,WIZARD_SPELL_TRAP))
		CreateVisualEffectObject("SPFLSRIN",Player4)
		Wait(1)
		CreateVisualEffectObject("SPFIREPI",Player4)
		ActionOverride(Player4,ReallyForceSpell(Player4,WIZARD_SPELL_TRAP))
		CreateVisualEffectObject("SPFLSRIN",Player5)
		Wait(1)
		CreateVisualEffectObject("SPFIREPI",Player5)
		ActionOverride(Player5,ReallyForceSpell(Player5,WIZARD_SPELL_TRAP))
		CreateVisualEffectObject("SPFLSRIN",Player6)
		Wait(1)
		CreateVisualEffectObject("SPFIREPI",Player6)
		ActionOverride(Player6,ReallyForceSpell(Player6,WIZARD_SPELL_TRAP))
		FadeToColor([20.0],0)
		Wait(1)
		ClearAllActions()
		DayNight(DAWN_END)
		LeaveAreaLUAPanic("HB#ArP","",[637.513],14)
		LeaveAreaLUA("HB#ArP","",[637.513],14)
		ActionOverride(Player2,LeaveAreaLUA("HB#ArP","",[822.430],14))
		ActionOverride(Player3,LeaveAreaLUA("HB#ArP","",[405.676],9))
		ActionOverride(Player4,LeaveAreaLUA("HB#ArP","",[549.745],9))
		ActionOverride(Player5,LeaveAreaLUA("HB#ArP","",[639.848],9))
		ActionOverride(Player6,LeaveAreaLUA("HB#ArP","",[780.447],14))
		MoveViewObject("HB#JD",INSTANT)
		ActionOverride(Player2,PlayDeadInterruptable(100000))
		ActionOverride(Player3,PlayDeadInterruptable(100000))
		ActionOverride(Player4,PlayDeadInterruptable(100000))
		ActionOverride(Player5,PlayDeadInterruptable(100000))
		ActionOverride(Player6,PlayDeadInterruptable(100000))
		CreateCreature("HB#JD",[731.581],6)
		Explore()
		FadeFromColor([20.0],0)
		Wait(1)
		PlaySong(0)
                PlaySound("HB#MusiH")
		DisplayStringWait("HB#JD",@50)
		DisplayStringWait(Myself,@51)
		DisplayStringWait("HB#JD",@52)
		Wait(3)
		FadeToColor([20.0],0)
		ActionOverride("HB#JD",DestroySelf())
                LeaveAreaLUAPanic("HB#ArT","",[2603.1028],4)
		LeaveAreaLUA("HB#ArT","",[2603.1028],4)
		MoveViewObject("HB#Minta",INSTANT)
		CreateCreature("HB#JD",[2357.1202],10)
		CreateCreature("HB#Minta",[2538.1113],11)
		FadeFromColor([20.0],0)
		Wait(1)
		CreateVisualEffectObject("ICRMPARI","HB#Minta")
		ReallyForceSpell(Myself,CUTSCENE_DAMAGE_1)
		ReallyForceSpell(Myself,CLERIC_DRAW_UPON_HOLY_MIGHT)
		PlaySound("EFF_M20")
		Wait(1)
                ApplySpell(Myself,SLAYER_CHANGE_CUT_SCENE)
		Wait(3)
		CreateVisualEffectObject("ICRMPARI","HB#Minta")
		ReallyForceSpell(Myself,WIZARD_SPELL_TRAP)
		DisplayStringWait("HB#JD",@53)
		DisplayStringWait("HB#Minta",@54)
		DisplayStringWait("HB#JD",@55)
		DisplayStringWait("HB#Minta",@56)
		ActionOverride("HB#Minta",ReallyForceSpell("HB#Minta",DRYAD_TELEPORT))
		Wait(5)
                FadeToColor([20.0],0)
                Wait(1)
                ClearAllActions()
                DayNight(MIDNIGHT)
                ActionOverride("HB#JD",DestroySelf())
                LeaveAreaLUAPanic("HB#ArP","",[637.513],14)
		LeaveAreaLUA("HB#ArP","",[637.513],14)
		MoveViewObject(Myself,INSTANT)
		ActionOverride(Player2,PlayDeadInterruptable(1))
		ActionOverride(Player3,PlayDeadInterruptable(1))
		ActionOverride(Player4,PlayDeadInterruptable(1))
		ActionOverride(Player5,PlayDeadInterruptable(1))
		ActionOverride(Player6,PlayDeadInterruptable(1))
		Wait(1)
		ActionOverride("HB#Henda",JumpToPoint([731.581]))
		FadeFromColor([20.0],0)
		Wait(1)
		DisplayStringWait("HB#Henda",@57)
		DisplayStringWait(Myself,@58)
		DisplayStringWait("HB#Henda",@59)
		FadeToColor([20.0],0)
		LeaveAreaLUAPanic("AR1700","",[3096.1020],14)
		LeaveAreaLUA("AR1700","",[3096.1020],14)
		ActionOverride(Player2,LeaveAreaLUA("AR1700","",[3145.988],14))
		ActionOverride(Player3,LeaveAreaLUA("AR1700","",[3061.988],14))
		ActionOverride(Player4,LeaveAreaLUA("AR1700","",[3168.954],14))
		ActionOverride(Player5,LeaveAreaLUA("AR1700","",[3027.970],14))
		ActionOverride(Player6,LeaveAreaLUA("AR1700","",[3097.956],14))
		MoveViewObject(Myself,INSTANT)
		FadeFromColor([20.0],0)
		Wait(1)
		SetGlobal("HB#Chasseurs","GLOBAL",8)
		ActionOverride("HB#JD",StartDialogueNoSet(Player1))
		EndCutSceneMode()
END