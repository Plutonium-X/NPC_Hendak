// DEBUT DE LA ROMANCE


IF
Global("HB#HendakJoinedParty","GLOBAL",1)
THEN
RESPONSE #100
RealSetGlobalTimer("HB#HendaRomance","GLOBAL",1)
SetGlobal("HB#HendaLoveTlk","LOCALS",1)
SetGlobal("HB#HendakJoinedParty","GLOBAL",2)
END


IF
RealGlobalTimerExpired("HB#HendaRomance","GLOBAL")
AreaType(OUTDOOR)
Global("HB#HendaRomanceActive","GLOBAL",0)
InParty("HB#Henda")
!StateCheck(Player1,CD_STATE_NOTVALID)
!StateCheck("HB#Henda",CD_STATE_NOTVALID)
CombatCounter(0)
Global("HB#HendaLoveTlk","LOCALS",1)
THEN
RESPONSE #100
PlaySong(0)
    PlaySound("HB#MusiB")
SetGlobal("HB#HendaRomanceActive","GLOBAL",1)
SetGlobal("HB#HendaLoveTlk","LOCALS",2)
SetDialog("HB#HendR")
Dialog(Player1)
END

