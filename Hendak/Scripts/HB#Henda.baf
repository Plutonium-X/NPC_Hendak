
// DEBUT DE LA QUETE DES PIRATES

// SI QUETE DES ESCLAVES TERMINEE ET HENDAK DANS LE GROUPE


IF
 AreaCheck("AR0405")
 Global("HB#EnfantsLiberes","GLOBAL",3)
 Global("HB#BenExists","GLOBAL",0)

THEN
 RESPONSE #100
SetGlobal("HB#EnfantsLiberes","GLOBAL",4)
SetGlobal("HB#BenExists","GLOBAL",1)
CreateCreatureObjectOffScreen("HB#Ben",Player1,0,0,0)
PlaySong(0)
PlaySound("HB#MusiA")
END

//DEBUT QUETE DES PIRATES

IF
 AreaCheck("AR0313")
 Global("HB#Pirates","GLOBAL",1)
 Global("HB#DuncaExists","GLOBAL",0)

THEN
 RESPONSE #100
SetGlobal("HB#Pirates","GLOBAL",2)
SetGlobal("HB#DuncaExists","GLOBAL",1)
CreateCreature("HB#Dunca",[732.344],2)
END



IF
 AreaCheck("AR0310")
 Global("HB#Pirates","GLOBAL",3)
 Global("HB#LeSerExists","GLOBAL",0)

THEN
 RESPONSE #100
 SetGlobal("HB#Pirates","GLOBAL",4)
 StartCutSceneMode()
 StartCutScene("HB#CtSer")
END

IF
 AreaCheck("AR0310")
 Global("HB#Pirates","GLOBAL",100)
 Global("HB#LeSerExists","GLOBAL",0)

THEN
 RESPONSE #100
 SetGlobal("HB#Pirates","GLOBAL",4)
 StartCutSceneMode()
 StartCutScene("HB#CtSer")
END

IF
Global("HB#Poursuite","GLOBAL",3)
THEN
  RESPONSE #100
  SetDialog("HB#HendR")
  Dialog(Player1)
END



// LE SINGE VULGAIRE

IF
 AreaCheck("AR1602")
 Global("HB#Poursuite","GLOBAL",4)
 Global("HB#SmeeExists","GLOBAL",0)

THEN
 RESPONSE #100
SetGlobal("HB#Poursuite","GLOBAL",5)
SetGlobal("HB#SmeeExists","GLOBAL",1)
CreateCreature("HB#Smee",[568.422],6)
END

IF
Global("HB#Poursuite","GLOBAL",5)
See("HB#Smee")
THEN
  RESPONSE #100
  PlaySong(0)
    PlaySound("HB#MusiD")
  SetDialog("HB#HendR")
  Dialog(Player1)
END

IF
Global("HB#Poursuite","GLOBAL",6)
THEN
    RESPONSE #100
    MoveToObject("HB#Smee")
    ActionOverride("HB#Smee",StartDialogueNoSet(Player1))
END




//2è RENCONTRE AVEC LE SERPENT

IF
 AreaCheck("AR1500")
 Global("HB#Poursuite","GLOBAL",7)
 Global("HB#SerpeExists","GLOBAL",0)

THEN
 RESPONSE #100
SetGlobal("HB#Poursuite","GLOBAL",8)
SetGlobal("HB#SerpeExists","GLOBAL",1)
CreateCreature("HB#Serpe",[1666.1956],1)
CreateCreature("HB#Smee",[1786.1819],13)
CreateCreature("HB#LeSer",[1880.1869],6)

END

//MORT DU SERPENT

IF
Global("HB#Poursuite","GLOBAL",17)
THEN
  RESPONSE #100
  SetDialog("HB#HendR")
  Dialog(Player1)
END





// LA PASSE DU PETIT CROC

IF
 AreaCheck("AR1700")
 Global("HB#Chasseurs","GLOBAL",1)
 Global("HB#AniaExists","GLOBAL",0)
 Global("HB#JDExists","GLOBAL",0)
 Global("HB#KelshExists","GLOBAL",0)
 Global("HB#KrodExists","GLOBAL",0)
 Global("HB#MintaExists","GLOBAL",0)
 Global("HB#UlzarExists","GLOBAL",0)

THEN
 RESPONSE #100
 FadeToColor([1.0],0)
 DayNight(MIDNIGHT)
 FadeFromColor([20.0],0)
SetGlobal("HB#Chasseurs","GLOBAL",2)
SetGlobal("HB#AniaExists","GLOBAL",1)     
CreateCreature("HB#Ania",[3148.1127],0)
SetGlobal("HB#JDExists","GLOBAL",1)
CreateCreature("HB#JD",[3284.1083],3)
SetGlobal("HB#KelshExists","GLOBAL",1)
CreateCreature("HB#Kelsh",[3257.1188],5)
SetGlobal("HB#KrodExists","GLOBAL",1)
CreateCreature("HB#Krod",[3080.1331],8)
SetGlobal("HB#MintaExists","GLOBAL",1)
CreateCreature("HB#Minta",[2889.1196],11)
SetGlobal("HB#UlzarExists","GLOBAL",1)
CreateCreature("HB#Ulzar",[2922.1082],13)

END


IF
 AreaCheck("AR1700")
 Global("HB#Chasseurs","GLOBAL",2)
 THEN
 RESPONSE #100
 SetDialog("HB#HendR")
  Dialog(Player1)
END


IF
 AreaCheck("AR1700")
 Global("HB#Chasseurs","GLOBAL",3)

THEN
 RESPONSE #100
 SetGlobal("HB#Chasseurs","GLOBAL",4)
 StartCutSceneMode()
 StartCutScene("HB#CtDan")
END

IF
 AreaCheck("AR1700")
 Global("HB#Chasseurs","GLOBAL",6)

THEN
 RESPONSE #100
 SetGlobal("HB#Chasseurs","GLOBAL",7)
 StartCutSceneMode()
 StartCutScene("HB#CtPri")
END



//COMBAT FINAL
IF
Global("HB#Chasseurs","GLOBAL",9)
Dead("HB#JD")
Dead("HB#Ania")
Dead("HB#Kelsh")
Dead("HB#Krod")
Dead("HB#Minta")
Dead("HB#Ulzar")
THEN
  RESPONSE #100
  PlaySong(0)
  PlaySound("HB#MusiJ")
  SetGlobal("HB#Chasseurs","GLOBAL",10)
END


