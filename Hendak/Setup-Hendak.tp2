// COMPILATION ITEMS POUR SOA

// Items divers

COPY ~Hendak/Items/HB#Fourr.itm~ ~override~ SAY NAME1 @500 SAY NAME2 @500 SAY DESC @501
COPY ~Hendak/Items/HB#scimi.itm~ ~override~ SAY NAME1 @503 SAY NAME2 @503 SAY DESC @504
COPY ~Hendak/Items/HB#key01.itm~ ~override~ SAY NAME1 @502 SAY NAME2 @502 SAY DESC @5021
COPY ~Hendak/Items/HB#Imun.itm~ ~override~
COPY ~Hendak/Items/HB#Four2.itm~ ~override~ SAY NAME1 @500 SAY NAME2 @500 SAY DESC @505
COPY ~Hendak/Items/HB#Note.itm~ ~override~ SAY NAME1 @506 SAY NAME2 @506 SAY DESC @507
COPY ~Hendak/Items/HB#epee.itm~ ~override~ SAY NAME1 @508 SAY NAME2 @508 SAY DESC @509






// SCRIPT DE MAPS POUR SOA

EXTEND_BOTTOM ~AR0406.bcs~ ~Hendak/Scripts/HB#Ar406.baf~


//MAPS POUR SOA
COPY ~Hendak/Areas/HB#ARP.are~ ~override~
COPY ~Hendak/Areas/HB#ART.are~ ~override~


// CUTSCENES POUR SOA

COMPILE ~Hendak/Scripts/HB#CtRec.baf~
COMPILE ~Hendak/Scripts/HB#CtSer.baf~
COMPILE ~Hendak/Scripts/HB#CtFui.baf~
COMPILE ~Hendak/Scripts/HB#CtPir.baf~
        USING ~Hendak/Translation/French/HB#LeSer.tra~
COMPILE ~Hendak/Scripts/HB#CtMor.baf~
COMPILE ~Hendak/Scripts/HB#CtDan.baf~
COMPILE ~Hendak/Scripts/HB#CtPri.baf~
        USING ~Hendak/Translation/French/HB#JD.tra~
COMPILE ~Hendak/Scripts/HB#CtBa1.baf~
COMPILE ~Hendak/Scripts/HB#CtBa3.baf~
COMPILE ~Hendak/Scripts/HB#CtBa4.baf~
COMPILE ~Hendak/Scripts/HB#CtBa5.baf~


//PATCHS DE ZONE

COPY_EXISTING ~AR0313.are~ ~override/AR0313.are~

WRITE_SHORT 0x10e8 100 // Porte incrochetable
WRITE_ASCII 0x10d4 ~HB#Key01~ // Cle pour ouvrir la porte

// PATCHS DE CREATURES

COPY_EXISTING ~PIRSEA01.cre~ ~override/PIRSEA01.cre~

WRITE_SHORT 0x2cc 0



// PORTRAITS

ACTION_IF GAME_IS ~BG2 TOB~ THEN BEGIN
	COPY ~Hendak/Pictures~ ~override~
END

ACTION_IF GAME_IS ~BG2EE EET~ THEN BEGIN
	COPY ~Hendak/PicturesEE~ ~override~
	ADD_JOURNAL @14 @21 @900000 @418 @438 @453 @457 @465 @440 USING ~Hendak\Translation\French\HB#HENDA.TRA~
END

// BAMS

COPY ~Hendak/Bams~ ~override~

// 2DA POUR DIALOGUES
// LAISSER A LA FIN DU FICHIER

// Pour SoA

APPEND ~pdialog.2da~
~HB#Henda      HB#HendP           HB#HendJ          HB#HendD~
UNLESS ~HB#Henda~
UNLESS ~25POST~

// Pour SoA + ToB

APPEND ~pdialog.2da~
~HB#Henda      HB#HendP           HB#HendJ          HB#HendD       HB#He25P           HB#He25J              HB#He25D              HB#HeD25~
UNLESS ~HB#Henda~
IF ~25POST~

// Banters SoA + ToB

APPEND ~interdia.2da~
  ~HB#Henda      HB#HendB       HB#HeB25~
UNLESS ~HB#Henda~