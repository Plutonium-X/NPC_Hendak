BACKUP ~Hendak/backup~
AUTHOR ~Totonin
        Installation ToB requise!~
		
ALWAYS
	ACTION_IF GAME_IS ~BG2EE EET~ THEN BEGIN
		ACTION_DEFINE_ARRAY Hendak_reload BEGIN
		~HB#Ben.tra~
		~HB#Dunca.tra~
		~HB#Henda.tra~
		~HB#JD.tra~
		~HB#LeSer.tra~
		~HB#Norma.tra~
		~HB#Smee.tra~
		~Setup.tra~
		END
		ACTION_DEFINE_ARRAY Hendak_noconvert BEGIN END
			LAF HANDLE_CHARSETS
			INT_VAR
			infer_charset = 1
			STR_VAR
			tra_path = EVAL ~%MOD_FOLDER%/Translation~
			noconvert_array = Hendak_noconvert
			reload_array = Hendak_reload
		END
	END
END


LANGUAGE ~Francais~
	 ~french~
	 ~Hendak/Translation/French/Setup.tra~

BEGIN @0

REQUIRE_FILE ~data/25dialog.bif~ ~Le programme ne détecte pas Throne Of Bhaal. L'expansion Throne Of Bhaal doit être installé pour permettre l'installation de Hendak le barbare.~
REQUIRE_FILE ~data/25scripts.bif~ ~Le programme ne détecte pas Throne Of Bhaal. Throne Of Bhaal doit être installé pour permettre l'installation de Hendak le barbare.~

// AJOUT DU CD_STATE_NOTVALID

APPEND ~STATE.IDS~ ~0x80101FEF CD_STATE_NOTVALID~
UNLESS ~CD_STATE_NOTVALID~


COPY ~Hendak/Creatures/HB#Henda.cre~ ~override~
SAY NAME1 @10
SAY NAME2 @10
SAY BIO @11

// Patch No Musique

COPY ~Hendak\Music\HB#Blank.mus~ ~music~
COPY_EXISTING ~songlist.2da~ ~override~
SET_2DA_ENTRY 0 2 3 ~HB#BLANK.MUS~

// Répertoire Sons

COPY ~Hendak/Sounds~ ~override~

// Commandes décodeurs/encodeurs

AT_INTERACTIVE_EXIT ~Hendak/Music/Install-mus.bat~
AT_INTERACTIVE_UNINSTALL ~Hendak/Music/Uninstall-mus.bat~

AT_INTERACTIVE_EXIT ~Hendak/Sounds/Audioin.bat~
AT_INTERACTIVE_UNINSTALL ~Hendak/Sounds/Audiouninstall.bat~






// COMPILATION DES FICHIERS DIALOGUES D'HENDAK (SOA)

// Avant recrutement
COMPILE ~Hendak/Dialogues/HB#Henda.d~
    USING ~Hendak/Translation/French/HB#Henda.tra~

// Après recrutement
COMPILE ~Hendak/Dialogues/HB#HendJ.d~
    USING ~Hendak/Translation/French/HB#Henda.tra~
// Banters
COMPILE ~Hendak/Dialogues/HB#HendB.d~
    USING ~Hendak/Translation/French/HB#Henda.tra~
// Dialogues avec Charname
COMPILE ~Hendak/Dialogues/HB#HendR.d~
    USING ~Hendak/Translation/French/HB#Henda.tra~
// Scripts
COMPILE ~Hendak/Scripts/HB#Henda.baf~
    USING ~Hendak/Translations/French/HB#Henda.tra~




    
    


// COMPILATION DES CREATURES
// Ben

COPY ~HENDAK/Creatures/HB#Ben.cre~ ~override~
SAY NAME1 @21
SAY NAME2 @21
COMPILE ~Hendak/Dialogues/HB#Ben.d~ ~override~
    USING ~Hendak/Translation/French/HB#Ben.tra~
COMPILE ~Hendak/Scripts/HB#Ben.baf~

// Duncan

COPY ~HENDAK/Creatures/HB#Dunca.cre~ ~override~
SAY NAME1 @22
SAY NAME2 @22
COMPILE ~Hendak/Dialogues/HB#Dunca.d~ ~override~
    USING ~Hendak/Translation/French/HB#Dunca.tra~
COMPILE ~Hendak/Scripts/HB#Dunca.baf~

// Le Serpent

COPY ~HENDAK/Creatures/HB#LeSer.cre~ ~override~
SAY NAME1 @20
SAY NAME2 @20
COMPILE ~Hendak/Dialogues/HB#LeSer.d~ ~override~
    USING ~Hendak/Translation/French/HB#LeSer.tra~
COMPILE ~Hendak/Scripts/HB#LeSer.baf~
    USING ~Hendak/Translation/French/HB#LeSer.tra~

// Smee

COPY ~HENDAK/Creatures/HB#Smee.cre~ ~override~
SAY NAME1 @23
SAY NAME2 @23
COMPILE ~Hendak/Dialogues/HB#Smee.d~ ~override~
    USING ~Hendak/Translation/French/HB#Smee.tra~
COMPILE ~Hendak/Scripts/HB#Smee.baf~
        USING ~Hendak/Translation/French/HB#Smee.tra~

//Pirates

COPY ~Hendak/Creatures/HB#Pir01.cre~ ~override~
SAY NAME1 @24
SAY NAME2 @24

COPY ~Hendak/Creatures/HB#Pir02.cre~ ~override~
SAY NAME1 @24
SAY NAME2 @24

COPY ~Hendak/Creatures/HB#Pir03.cre~ ~override~
SAY NAME1 @24
SAY NAME2 @24

COPY ~Hendak/Creatures/HB#Pir04.cre~ ~override~
SAY NAME1 @24
SAY NAME2 @24

COPY ~Hendak/Creatures/HB#PIR05.cre~ ~override~
SAY NAME1 @24
SAY NAME2 @24
COMPILE ~Hendak/Scripts/HB#PIR05.baf~

COPY ~Hendak/Creatures/HB#Serpe.cre~ ~override~
SAY NAME1 @25
SAY NAME2 @25


//Chasseurs


COPY ~Hendak/Creatures/HB#Ania.cre~ ~override~
